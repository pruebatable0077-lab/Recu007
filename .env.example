# ============================================================
# EJEMPLO de variables de entorno — NO pongas aquí tu clave real.
# Este archivo solo muestra los nombres. Copia su contenido a un
# archivo llamado ".env" (que está en .gitignore) o configura las
# variables directamente en el panel de tu hosting.
# ============================================================

# Clave de la IA (Groq ejemplo). NUNCA se sube a GitHub.
GROQ_API_KEY=tu_clave_aqui

# Modelo a usar
AI_MODEL=llama-3.3-70b-versatile

# Puerto del servidor local
PORT=3000
